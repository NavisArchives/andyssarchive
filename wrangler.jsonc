{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andyssarchives-ugc",
  "compatibility_date": "2026-09-19",

  // Pure static site: no Worker script, just the built folder.
  // `_headers` inside dist/ is honoured for caching + security headers.
  "assets": {
    "directory": "./dist"
  },

  // Custom Domain: Cloudflare provisions the DNS record and TLS cert itself
  // because andyssarchives.com is a zone on this same account.
  // The apex and www belong to the portfolio (Worker "andyssarchives").
  "routes": [
    { "pattern": "ugc.andyssarchives.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
